    {
      "parameters": {
        "jsCode": "// Le base64 envoyé par le navigateur redevient des octets, car l'envoi vers\n// le stockage Adobe est un PUT binaire brut.\nconst b64 = $('Webhook').first().json.body.pdfBase64 || '';\nif (!b64.startsWith('JVBER')) {          // « %PDF » en base64\n  throw new Error('Le corps de la requête ne contient pas de PDF.');\n}\n\nreturn [{\n  json: {},\n  binary: {\n    data: await this.helpers.prepareBinaryData(\n      Buffer.from(b64, 'base64'), 'source.pdf', 'application/pdf'),\n  },\n}];"
      },
