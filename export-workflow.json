      },
      "id": "b2000000-0000-4000-8000-000000000011",
      "name": "Feuille",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        2600,
        20
      ]
    },
    {
      "parameters": {
        "jsCode": "// Le fichier converti repart en base64 dans la réponse du webhook.\nconst format = $('Webhook').first().json.body.format === 'xlsx' ? 'xlsx' : 'docx';\nconst bytes = await this.helpers.getBinaryDataBuffer(0, 'data');\n\nreturn [{\n  json: {\n    ok: true,\n    format,\n    fileBase64: bytes.toString('base64'),\n  },\n}];"
      },
      "id": "b2000000-0000-4000-8000-00000000000c",
      "name": "Sortie",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2600,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Le corps d'un échec Adobe varie ; on aplatit ce qu'on trouve.\nconst s = $input.first().json;\nconst detail = s.error?.message ?? s.error?.title ?? s.message ?? JSON.stringify(s.error ?? s);\n\nreturn [{ json: { ok: false, error: 'Conversion Adobe échouée : ' + detail } }];"
      },
      "id": "b2000000-0000-4000-8000-00000000000d",
      "name": "Erreur",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        300
      ]
